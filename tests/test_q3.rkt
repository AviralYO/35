#lang racket/base
(require racket/runtime-path)
(define-runtime-path source "../code/35_q3.rkt")
(define ns (make-base-namespace))
(define checks 0)
(define (check label actual expected)
  (set! checks (+ checks 1))
  (unless (equal? actual expected)
    (error 'q3 "~a: got ~s; expected ~s" label actual expected)))
(define (capture thunk)
  (define out (open-output-string))
  (parameterize ((current-output-port out)) (thunk))
  (get-output-string out))
(check 'silent-load
  (capture (lambda ()
    (call-with-input-file source
      (lambda (in)
        (read-line in)
        (let loop ()
          (define form (read in))
          (unless (eof-object? form)
            (unless (and (pair? form) (eq? (car form) 'define))
              (error 'q3 "Solution contains a top-level non-definition"))
            (parameterize ((current-namespace ns)) (eval form))
            (loop))))))) "")
(define (invoke name . args)
  (apply (parameterize ((current-namespace ns)) (eval name)) args))
(define t1 '(4 (2 (1 () ()) (3 () ())) (6 (5 () ()) (7 () ()))))
(define t2 '(1 () (2 () (3 () ()))) )
(define t3 '(a (b () ()) (c () ())))
(check 't1-inorder (capture (lambda () (invoke 'print-inorder t1)))
       "(1 2 3 4 5 6 7)\n")
(check 't1-all (capture (lambda () (invoke 'print-all-traversals t1)))
       "(1 2 3 4 5 6 7)\n(4 2 1 3 6 5 7)\n(1 3 2 5 7 6 4)\n")
(check 't1-stats (capture (lambda () (invoke 'print-height-and-leaves t1))) "(3 4)\n")
(check 't2-all (capture (lambda () (invoke 'print-all-traversals t2)))
       "(1 2 3)\n(1 2 3)\n(3 2 1)\n")
(check 't2-stats (capture (lambda () (invoke 'print-height-and-leaves t2))) "(3 1)\n")
(check 't3-all (capture (lambda () (invoke 'print-all-traversals t3)))
       "(b a c)\n(a b c)\n(b c a)\n")
(check 't3-stats (capture (lambda () (invoke 'print-height-and-leaves t3))) "(2 2)\n")
(check 'empty-inorder (capture (lambda () (invoke 'print-inorder '()))) "()\n")
(check 'empty-all (capture (lambda () (invoke 'print-all-traversals '()))) "()\n()\n()\n")
(check 'empty-stats (capture (lambda () (invoke 'print-height-and-leaves '()))) "(0 0)\n")
(check 'leaf-stats (capture (lambda () (invoke 'print-height-and-leaves '(a () ())))) "(1 1)\n")

; The oracle uses ordinary recursive concatenation, unlike the worklist solution.
(define (reference-order t mode)
  (if (null? t) '()
      (let ((left (reference-order (cadr t) mode))
            (right (reference-order (caddr t) mode)) (v (list (car t))))
        (case mode
          ((inorder) (append left v right))
          ((preorder) (append v left right))
          (else (append left right v))))))
(define (reference-stats t)
  (if (null? t) '(0 0)
      (let ((l (reference-stats (cadr t))) (r (reference-stats (caddr t))))
        (list (+ 1 (max (car l) (car r)))
              (if (and (null? (cadr t)) (null? (caddr t))) 1 (+ (cadr l) (cadr r)))))))
(define (trees n)
  (if (= n 0) (list '())
      (for*/list ((i (in-range n)) (l (in-list (trees i)))
                  (r (in-list (trees (- n i 1)))))
        (list (if (even? n) 'a n) l r))))
(for* ((n (in-range 7)) (tree (in-list (trees n))))
  (for ((mode '(inorder preorder postorder)))
    (check (list n mode) (invoke 'traversal-values tree mode) (reference-order tree mode)))
  (check (list n 'stats) (invoke 'tree-statistics tree) (reference-stats tree))
  (check (list n 'printed-traversals)
    (capture (lambda () (invoke 'print-all-traversals tree)))
    (apply string-append
      (map (lambda (mode) (format "~a\n" (reference-order tree mode)))
           '(inorder preorder postorder)))))
(define deep (for/fold ((t '())) ((i (in-range 10000))) (list i t '())))
(check 'deep-stats (invoke 'tree-statistics deep) '(10000 1))
(check 'deep-inorder (invoke 'traversal-values deep 'inorder) (build-list 10000 values))
(displayln (format "S1: ~a checks passed" checks))
