#lang racket/base
(require racket/runtime-path (only-in racket/list make-list))
(define-runtime-path source "../code/35_q4.rkt")
(define ns (make-base-namespace))
(define checks 0)
(define (check label actual expected)
  (set! checks (+ checks 1))
  (unless (equal? actual expected)
    (error 'q4 "~a: got ~s; expected ~s" label actual expected)))
(define (capture thunk)
  (define out (open-output-string))
  (parameterize ((current-output-port out)) (thunk))
  (get-output-string out))
(check 'silent-load
  (capture (lambda ()
    (call-with-input-file source
      (lambda (in)
        (read-line in)
        (let loop ()
          (define form (read in))
          (unless (eof-object? form)
            (unless (and (pair? form) (eq? (car form) 'define))
              (error 'q4 "Solution contains a top-level non-definition"))
            (parameterize ((current-namespace ns)) (eval form))
            (loop))))))) "")
(define (get-function name) (parameterize ((current-namespace ns)) (eval name)))
(define (invoke name . args) (apply (get-function name) args))
(define examples
  '(("42 ((1 2) (3 4 5) (6) ()) 3" "((42 1 2) (3 4 5) (42 6) (42))\n")
    ("0 (((1) 2) (3) ((4 5 6) ())) 3" "((0 (0 1) 2) (0 3) (0 (4 5 6) (0)))\n")
    ("7 () 3" "(7)\n")
    ("7 () 0" "()\n")))
(for ((example (in-list examples)))
  (check 'pdf-io
    (capture (lambda ()
      (parameterize ((current-input-port (open-input-string (car example))))
        (invoke 'print-insert-result))))
    (cadr example)))
(check 'length-empty (invoke 'my-length '()) 0)
(check 'length-nested (invoke 'my-length '(() (1 2 3) a)) 3)
(check 'map-empty (invoke 'my-map add1 '()) '())
(define seen '())
(check 'map-values
  (invoke 'my-map (lambda (x) (set! seen (cons x seen)) (+ x 10)) '(1 2 3)) '(11 12 13))
(check 'map-order-and-count (reverse seen) '(1 2 3))
(check 'equal-threshold (invoke 'insert-if-short 'x '((1 2) () a) 3) '((x 1 2) (x) a))
(check 'top-insertion (invoke 'insert-if-short 'x '(a b) 3) '(x a b))
(check 'zero-threshold (invoke 'insert-if-short 'x '(() (a ()) b) 0) '(() (a ()) b))
(check 'symbol-and-multidigit (invoke 'insert-if-short 'z '((12) a ()) 2) '((z 12) a (z)))
(define exact-two (invoke 'make-inserter 'x (lambda (size) (= size 2))))
(check 'higher-order-equality (exact-two '((a b) () c)) '((x a b) () c))
(define long-enough (invoke 'make-inserter 'x (lambda (size) (>= size 2))))
(check 'higher-order-ge (long-enough '((a b) (c) ())) '(x (x a b) (c) ()))
(define visited-lengths '())
(define recording-inserter
  (invoke 'make-inserter 'x
    (lambda (size) (set! visited-lengths (cons size visited-lengths)) (= size 0))))
(check 'empty-only (recording-inserter '(() (a b) z)) '((x) (a b) z))
(check 'one-predicate-call-per-original-list (reverse visited-lengths) '(3 0 2))

; Independent recursive oracle uses built-in list functions only in this harness.
(define (reference x lst len-ok?)
  (define children (map (lambda (v) (if (list? v) (reference x v len-ok?) v)) lst))
  (if (len-ok? (length lst)) (cons x children) children))
(random-seed 3012026)
(define (random-list depth)
  (build-list (random 5)
    (lambda (_)
      (if (and (> depth 0) (= (random 3) 0))
          (random-list (- depth 1))
          (if (= (random 2) 0) 'a (random 10))))))
(for ((i (in-range 500)))
  (define lst (random-list 5))
  (for ((n (in-range 6)))
    (check (list 'random i n) (invoke 'insert-if-short 'x lst n)
      (reference 'x lst (lambda (size) (< size n)))))
  (check (list 'random-generic i) (exact-two lst)
    (reference 'x lst (lambda (size) (= size 2)))))
(define flat (build-list 10000 values))
(check 'long-length (invoke 'my-length flat) 10000)
(check 'long-map (invoke 'my-map add1 flat) (build-list 10000 add1))
(check 'long-equal-threshold (invoke 'insert-if-short 42 flat 10000) flat)
(check 'long-insertion (invoke 'insert-if-short 42 flat 10001) (cons 42 flat))
(check 'wide-empty-sublists (invoke 'insert-if-short 'x (make-list 10000 '()) 1)
       (make-list 10000 '(x)))
(define deep (for/fold ((lst '())) ((i (in-range 100))) (list lst)))
(check 'depth-100 (invoke 'insert-if-short 'x deep 2)
       (reference 'x deep (lambda (size) (< size 2))))
(displayln (format "S2: ~a checks passed" checks))
